# Copy to .env.local and fill in. Never commit real values.

# Supabase project (Settings -> API). The publishable key is safe in the
# browser; the secret key bypasses row level security and stays server-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Public address of this app, used in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional email (Resend). Without a key, emails are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM="Vo Creative Co. <studio@vocreativeco.com>"

# Script drafting and voice extraction (Anthropic). Optional until build step 5.
ANTHROPIC_API_KEY=

# Background jobs (Inngest). Optional locally: run `npx inngest-cli dev`.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Onboarding call transcripts (Fireflies). Optional.
FIREFLIES_API_KEY=
